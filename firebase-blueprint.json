{
  "entities": {
    "users": {
      "title": "Users",
      "description": "User accounts and role authorizations",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "editor", "viewer", "demo"] },
        "createdAt": { "type": "string" },
        "lastLogin": { "type": "string" }
      },
      "required": ["uid", "email", "role"]
    },
    "activityLogs": {
      "title": "Activity Logs",
      "description": "System administrative logs and events",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "action": { "type": "string" },
        "performedBy": { "type": "string" },
        "timestamp": { "type": "string" },
        "details": { "type": "string" }
      },
      "required": ["action", "timestamp"]
    }
  }
}
